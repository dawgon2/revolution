<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.dawgon2.Revolution</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Revolution</name>
  <summary>Edit video, color and sound</summary>
  <developer id="io.github.dawgon2">
    <name>dawgon2</name>
  </developer>
  <description>
    <p>
      Revolution is an open-source video editor for Linux and Windows, based on FilmCraft. Cut on a
      timeline with source and program monitors, grade colour with nodes, wheels, curves and scopes,
      composite with keys and masks, mix sound with loudness meters, and export with hardware encoding.
    </p>
  </description>
  <launchable type="desktop-id">io.github.dawgon2.Revolution.desktop</launchable>
  <icon type="stock">io.github.dawgon2.Revolution</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/dawgon2/revolution</url>
  <url type="bugtracker">https://github.com/dawgon2/revolution/issues</url>
  <url type="help">https://github.com/dawgon2/revolution/tree/fork/docs/guide</url>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>AudioVideoEditing</category>
  </categories>
  <keywords>
    <keyword>video</keyword>
    <keyword>video editor</keyword>
    <keyword>timeline</keyword>
    <keyword>color grading</keyword>
    <keyword>nle</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Color workspace: a documentary cut with Lumetri Color, scopes, captions and loudness meters</caption>
      <image>https://raw.githubusercontent.com/dawgon2/revolution/fork/docs/images/filmcraft-hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>revolution</binary>
    <binary>revolution-cli</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
