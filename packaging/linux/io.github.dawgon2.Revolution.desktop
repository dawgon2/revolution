[Desktop Entry]
Type=Application
Name=Revolution
GenericName=Video Editor
Comment=Edit video, color and sound
Exec=revolution %F
TryExec=revolution
Icon=io.github.dawgon2.Revolution
Terminal=false
StartupNotify=true
StartupWMClass=io.github.dawgon2.Revolution
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=video;editor;film;timeline;color;grading;nle;
MimeType=application/x-filmcraft-project;video/mp4;video/quicktime;video/x-matroska;video/webm;video/mp2t;video/x-msvideo;application/mxf;video/mpeg;video/3gpp;
Actions=new-project;new-window;

[Desktop Action new-project]
Name=New Project
Exec=revolution --empty

[Desktop Action new-window]
Name=New Window
Exec=revolution --new-instance
