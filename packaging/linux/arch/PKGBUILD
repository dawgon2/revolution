# Arch Linux / CachyOS package for Revolution (the FilmCraft fork), built from this source tree
# (LINUX-PLAN L2.9; Revolution names, FORK-PLAN §1a.107: programs revolution / revolution-cli).
#
#   cd packaging/linux/arch && makepkg -si
#
# Builds from the checkout two levels up (no download). For an AUR-style package, replace the
# `_src` lines with a `source=("git+https://github.com/dawgon2/revolution.git#tag=revolution-$pkgver")`.
# The fork adds the split package `revolution-kde-thumbnailer` (Dolphin thumbnails of projects,
# fork/kde-thumbnailer, FORK-PLAN §1a.46): delete `package_revolution-kde-thumbnailer`, its name in
# `pkgname` and its build lines to drop it.

pkgbase=revolution
pkgname=(revolution revolution-kde-thumbnailer)
# Revolution's release version (tag `revolution-<pkgver>`; the workspace version stays upstream's).
# A static value: a `pkgver()` function would make makepkg rewrite this tracked file on every build.
pkgver=0.1.3
pkgrel=1
pkgdesc='Revolution: open-source, native video editor based on FilmCraft: edit video, color and sound'
arch=('x86_64' 'aarch64')
url='https://github.com/dawgon2/revolution'
license=('MIT OR Apache-2.0')
makedepends=('cargo' 'cmake' 'extra-cmake-modules' 'kio' 'qt6-base')
checkdepends=('python')
options=('!lto' '!debug')

_src() { realpath -- "$startdir/../../.."; }

prepare() {
  cd "$(_src)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_src)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  export FILMCRAFT_RELEASE_TAG="revolution-$pkgver"
  cargo build --frozen --release -p filmcraft -p filmcraft-cli
  cmake -S fork/kde-thumbnailer -B "$srcdir/kde-thumbnailer" -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DFILMCRAFT_CLI=revolution-cli
  cmake --build "$srcdir/kde-thumbnailer"
}

check() {
  cd "$(_src)"
  python3 packaging/linux/test_install.py
}

package_revolution() {
  depends=('gcc-libs' 'glibc' 'libxkbcommon' 'vulkan-icd-loader' 'alsa-lib' 'hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
  backup=('etc/ufw/applications.d/revolution')
  optdepends=(
    'xdg-desktop-portal-kde: KDE file dialogs, accent colour and inhibit on Plasma'
    'xdg-desktop-portal-gnome: file dialogs on GNOME'
    'libva: hardware video decoding (VA-API, loaded at run time)'
    'libva-mesa-driver: hardware video decoding on AMD'
    'intel-media-driver: hardware video decoding on Intel'
    'wayland: native Wayland window'
    'libx11: X11 fallback'
    'revolution-kde-thumbnailer: project thumbnails in Dolphin'
    'ffmpeg: fork only: proxies and fallback decoding through the system ffmpeg'
  )
  local src app=io.github.dawgon2.Revolution
  src="$(_src)"
  install -Dm755 "$srcdir/target/release/filmcraft" "$pkgdir/usr/bin/revolution"
  install -Dm755 "$srcdir/target/release/filmcraft-cli" "$pkgdir/usr/bin/revolution-cli"
  install -Dm644 "$src/packaging/linux/$app.desktop" "$pkgdir/usr/share/applications/$app.desktop"
  install -Dm644 "$src/packaging/linux/$app.mime.xml" "$pkgdir/usr/share/mime/packages/$app.xml"
  install -Dm644 "$src/packaging/linux/$app.thumbnailer" "$pkgdir/usr/share/thumbnailers/$app.thumbnailer"
  # firewall descriptions for receiving from a nearby computer (installed, not applied; §1a.118)
  install -Dm644 "$src/packaging/linux/firewall/revolution.ufw" "$pkgdir/etc/ufw/applications.d/revolution"
  install -Dm644 "$src/packaging/linux/firewall/revolution.firewalld.xml" "$pkgdir/usr/lib/firewalld/services/revolution.xml"
  install -d "$pkgdir/usr/share/metainfo"
  sed -e "s/@VERSION@/$pkgver/g" -e "s/@DATE@/$(date -u -d "@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y-%m-%d)/g" \
    "$src/packaging/linux/$app.metainfo.xml.in" > "$pkgdir/usr/share/metainfo/$app.metainfo.xml"
  install -d "$pkgdir/usr/share/icons"
  cp -R "$src/assets/app-icon/hicolor" "$pkgdir/usr/share/icons/"
  find "$pkgdir/usr/share/icons" -name '*.attribution' -delete
  install -Dm644 "$src/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 "$src/LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}

package_revolution-kde-thumbnailer() {
  pkgdesc='Dolphin thumbnails of Revolution projects (KIO plugin)'
  license=('MIT')
  depends=('revolution' 'kio' 'qt6-base')
  DESTDIR="$pkgdir" cmake --install "$srcdir/kde-thumbnailer"
  install -Dm644 "$(_src)/LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
