<?xml version="1.0" encoding="UTF-8"?>
<!-- FilmCraft's own file types (freedesktop shared-mime-info). Installed to
     share/mime/packages/ and registered with update-mime-database. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-filmcraft-project">
    <comment>FilmCraft project</comment>
    <sub-class-of type="application/json"/>
    <generic-icon name="video-x-generic"/>
    <icon name="io.github.dawgon2.Revolution"/>
    <!-- globs match case-insensitively: Film.FCPROJ too -->
    <glob pattern="*.fcproj"/>
  </mime-type>
</mime-info>
